{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python: Uvicorn (python_server)",
      "type": "python",
      "request": "launch",
      "module": "uvicorn",
      "args": ["python_server.main:app", "--reload" ,"--host", "localhost", "--port", "8001"],
      "justMyCode": true,
      "console": "integratedTerminal",
      "env": {

        "PYTHONPATH": "${workspaceFolder}"
      }
    },
    {
      "name": "Python: Run python_project/app.py",
      "type": "python",
      "request": "launch",
      "program": "${workspaceFolder}/python_project/app.py",
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ]
}
